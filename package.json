{
	"name": "dicechess-play",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Public Dice Chess play site — anonymous play vs bots, no sign-up required",
	"author": {
		"name": "Jegors Čemisovs",
		"url": "https://jc.id.lv"
	},
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fortemate/dicechess-play.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/verify-bundle.mjs",
		"verify:bundle": "node scripts/verify-bundle.mjs",
		"preview": "vite preview",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:functions",
		"check:functions": "tsc --noEmit -p functions/tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo \"\"",
		"test:e2e": "playwright test",
		"test:acceptance": "node --experimental-strip-types scripts/showcase-acceptance/runAll.ts"
	},
	"dependencies": {
		"@fortemate/dicechess-engine": "^0.7.2",
		"@lichess-org/chessground": "^10.1.1",
		"@sentry/sveltekit": "^10.72.0",
		"idb": "^8.0.3",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.4.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.9"
	}
}
