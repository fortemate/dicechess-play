{
	"name": "dicechess-play",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Public Dice Chess play site — anonymous play vs bots, no sign-up required",
	"author": {
		"name": "Jegors Čemisovs",
		"url": "https://jc.id.lv"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fortemate/dicechess-play.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/verify-bundle.mjs",
		"verify:bundle": "node scripts/verify-bundle.mjs",
		"preview": "vite preview",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:functions",
		"check:functions": "tsc --noEmit -p functions/tsconfig.json",
		"check:rules-version": "node --test scripts/verify-rules-version.test.mjs && node scripts/verify-rules-version.mjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo \"\"",
		"test:e2e": "playwright test",
		"test:pwa": "node scripts/prepare-pwa-test.mjs && playwright test --config playwright.pwa.config.ts",
		"test:acceptance": "node --experimental-strip-types scripts/showcase-acceptance/runAll.ts"
	},
	"dependencies": {
		"@fortemate/dicechess-engine": "0.17.1",
		"@lichess-org/chessground": "^10.4.2",
		"@sentry/sveltekit": "^11.10.0",
		"idb": "^8.0.3",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.2",
		"@inlang/paraglide-js-svelte": "^1.0.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.6",
		"@vite-pwa/sveltekit": "^2.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.12.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.6",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
