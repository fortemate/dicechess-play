# Copy to an ignored local env file before running Compose.
# Use absolute local paths. Keep password and TLS key values in separate files.
LAB_FRONTEND_DIR=/absolute/path/to/dicechess-play/dist-laboratory
LAB_FRONTEND_ORIGIN=https://localhost:8443
LAB_FRONTEND_PORT=8443
LAB_API_PORT=9443
LAB_PRUNE_INTERVAL_SECONDS=3600
LAB_PRUNE_BATCH_SIZE=100
LAB_TLS_CERT_FILE=/absolute/path/to/laboratory.crt
LAB_TLS_KEY_FILE=/absolute/path/to/laboratory.key
LAB_DATABASE_PASSWORD_FILE=/absolute/path/to/laboratory-db-password
LAB_DATABASE_ADMIN_PASSWORD_FILE=/absolute/path/to/postgres-admin-password
LAB_ADMISSION_OPEN=false
LAB_RETENTION_DAYS=30
LAB_JOIN_WINDOW_SECONDS=300

