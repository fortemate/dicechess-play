# --- install-time ---
# GitHub PAT with read:packages — needed to install @fortemate/dicechess-engine. Only the
# @fortemate scope resolves from GitHub Packages (see .npmrc); chessground and everything
# else come from the public registry. Export it before install:
#   export NODE_AUTH_TOKEN=$(gh auth token) && npm install
NODE_AUTH_TOKEN=

# --- runtime (Vite, client-exposed) ---
# Base URL of play-api — the authoritative human-vs-human server (e.g. http://localhost:8080).
# Also receives finished bot games at POST /ingest/games and relays them to analytics
# server-side (the browser never holds the analytics token). Leave empty to disable both
# live play (the /live routes) and recording (games still save to IndexedDB).
VITE_PLAY_API_URL=

# Sentry DSN for the dicechess-play project (org fortemate). Public by design — it is baked
# into the client bundle. Leave empty and the SDK is disabled entirely, which is the normal
# state for local development; set it only when you need to reproduce reporting itself.
VITE_SENTRY_DSN=

# Sentry environment tag. CI sets production/preview per deployment; locally anything goes.
VITE_SENTRY_ENVIRONMENT=
